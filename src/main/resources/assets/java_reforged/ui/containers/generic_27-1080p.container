@@import asset.local("styles/container_base/generic_27") as base

container "generic_27" {
    @base.container_base "base" ()

    background {
        @base.container_size "panel" (186, 178)
    }

    content {
        @base.label_text "title" (8, 6, 1)
        @base.inventory_text "inventory_title" (8, 74, 1)

        item_slots "menu" {
            map: "chest_27"

            @base.slot_container "container" (8, 18, 18, 16)
            @base.slot_inventory "inventory" (8, 85, 18, 16)
            @base.slot_hotbar "hotbar" (8, 143, 18, 16)
        }
    }

    foreground {
    }
}
